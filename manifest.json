{
  "manifest_version": 3,
  "name": "DE \u2192 EN Page Translator",
  "version": "1.8.4",
  "description": "Fast DE\u2192EN page translator: parallel batching, high concurrency, large packs.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "management"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/protocol.js",
        "shared/markers.js",
        "shared/lang.js",
        "shared/storage-keys.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Toggle DE\u2192EN translation on the current tab"
    }
  },
  "action": {
    "default_title": "Translate page: German \u2192 English (Alt+Shift+B)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
